echo.

set "SERVER_URL=https://final-latina-duo-zoo.trycloudflare.com"
set "STUDIO_KEY=rt9k4m7x2v8p"
set "DL_DIR=%USERPROFILE%\Downloads\Rooton_PC_Migration_Pack"
if not exist "%DL_DIR%" mkdir "%DL_DIR%"

call :download_and_extract "obsidian_caudex_quest.zip" "%USERPROFILE%\.ai-brain" "%USERPROFILE%\.ai-brain\GEMINI.md" "1/7 Obsidian Shared Brain (~/.ai-brain)"
call :download_and_extract "rooton_claude_homepage.zip" "%USERPROFILE%\rooton-claude" "%USERPROFILE%\rooton-claude\llms.txt" "2/7 Rooton Official Homepage (~/rooton-claude)"
call :download_and_extract "douga_master_studio.zip" "%USERPROFILE%\douga" "%USERPROFILE%\douga\studio_server.py" "3/7 Master Studio & Flipbook (~/douga)"
call :download_and_extract "wise_darwin_chiro_saas.zip" "%USERPROFILE%\Documents\antigravity\wise-darwin" "%USERPROFILE%\Documents\antigravity\wise-darwin\server.js" "4/7 Reservation & EMR SaaS (~/Documents/antigravity/wise-darwin)"
call :download_and_extract "antigravity_claude_configs.zip" "%USERPROFILE%" "%USERPROFILE%\.gemini\GEMINI.md" "5/7 Antigravity (.gemini) & Claude (.claude) 7-Crew Configs"
call :download_and_extract "kaiwa_travel_backend.zip" "%USERPROFILE%\kaiwa" "%USERPROFILE%\kaiwa\travel_server.py" "6/7 Travel Master Backend (~/kaiwa)"
